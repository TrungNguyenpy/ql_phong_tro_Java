<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Manager_room" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_slate_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary_slate_blue</item>

        <item name="android:windowBackground">@color/bg_light</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="colorSecondaryContainer">@color/primary_container</item>
    </style>

    <!-- Card -->
    <style name="Widget.Custom.CardStat" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#FFFFFF</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Custom.CardRoom" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="strokeColor">@color/stroke_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">1dp</item>
    </style>

    <!-- Form -->
    <style name="Widget.App.FieldLabel" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxStrokeColor">@color/primary_slate_blue</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="startIconTint">@color/text_primary</item>
        <item name="endIconTint">@color/text_primary</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/tonal_btn_bg</item>
        <item name="android:textColor">@color/primary_slate_blue</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Text -->
    <style name="Widget.App.SectionTitle" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.StatValue" parent="">
        <item name="android:paddingTop">12dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.StatLabel" parent="">
        <item name="android:paddingTop">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>


</resources>